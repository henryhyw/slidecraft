{
  "schema_version": "1.0.0",
  "policy_id": "preservation_first_generation_review",
  "material_failures_only": true,
  "maximum_material_issues": 5,
  "asset_footprint_tolerance_source": "per-asset generation contract",
  "exact_content_is_authoritative": true,
  "configured_canvas_is_authoritative": true,
  "configured_style_precedes_reference_incidentals": true,
  "optional_assets_may_be_omitted": true,
  "required_assets_must_be_present": true,
  "preservation_first_edit": true,
  "reviewer_returns_delta_only": true,
  "orchestrator_builds_edit_envelope": true,
  "review_output_format": "strict_json",
  "review_categories": [
    "configuration_compliance",
    "semantic_content_fidelity",
    "visual_structure",
    "visual_reference_fidelity",
    "canonical_asset_use",
    "legibility_local_consistency",
    "unnecessary_visual_explanation"
  ],
  "decision_values": ["PASS", "EDIT"]
}
