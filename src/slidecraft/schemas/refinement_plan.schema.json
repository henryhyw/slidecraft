{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "authored_by", "coordinate_space", "decision_rationale", "alignment_groups"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authored_by": {"const": "agent_reasoning"},
    "coordinate_space": {"enum": ["generation_region_px", "full_slide_px"]},
    "decision_rationale": {"type": "string", "minLength": 8},
    "alignment_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "semantic_basis", "anchor", "confidence", "members"],
        "properties": {
          "id": {"type": "string"},
          "semantic_basis": {"type": "string", "minLength": 8},
          "anchor": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "parent_padding_px": {"type": "number", "minimum": 0},
          "target_value": {"type": "number"},
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "member_entity_ids", "bbox_px", "parent_bbox_px"],
              "properties": {
                "id": {"type": "string"},
                "member_entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "bbox_px": {"$ref": "#/$defs/box"},
                "parent_bbox_px": {"$ref": "#/$defs/box"},
                "maximum_translation_px": {"type": "number", "minimum": 0},
                "minimum_clearance_px": {"type": "number", "minimum": 0},
                "obstacle_bboxes_px": {"type": "array", "items": {"$ref": "#/$defs/box"}}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "box": {
      "type": "array",
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false
    }
  },
  "additionalProperties": false
}
