{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "deck_id", "governing_thought", "storyline_archetype", "density_profile", "sections", "slides", "source_allocation", "design_system_snapshot", "quality_evaluation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deck_id": {"type": "string"},
    "governing_thought": {"type": "string"},
    "storyline_archetype": {"type": "string"},
    "density_profile": {"type": "object"},
    "density_analysis": {"type": "object"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "number", "title", "purpose", "slide_ids"],
        "properties": {
          "section_id": {"type": "string"},
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "purpose": {"type": "string"},
          "promise": {"type": ["string", "null"]},
          "slide_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "ordinal", "section_id", "role", "communication_job", "message_title", "source_atom_ids", "relationships", "route"],
        "properties": {
          "slide_id": {"type": "string"},
          "ordinal": {"type": "integer", "minimum": 1},
          "section_id": {"type": "string"},
          "role": {"type": "string"},
          "communication_job": {"type": "string"},
          "message_title": {"type": "string"},
          "source_atom_ids": {"type": "array", "items": {"type": "string"}},
          "asset_allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["asset_id", "usage", "placement", "reason"],
              "properties": {
                "asset_id": {"type": "string"},
                "usage": {"enum": ["optional", "mandatory"]},
                "placement": {"enum": ["icon_slot", "image_region"]},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "relationships": {"type": "array"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "semantic_unit_count": {"type": "integer", "minimum": 0},
          "supporting_evidence_count": {"type": "integer", "minimum": 0},
          "route": {"enum": ["system_layout", "image_generation"]},
          "system_layout_id": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "source_allocation": {"type": "array", "items": {"type": "object"}},
    "asset_allocation": {"type": "array", "items": {"type": "object"}},
    "design_system_snapshot": {"type": "object"},
    "quality_evaluation": {
      "type": "object",
      "required": ["storyline_coherence", "source_coverage", "slide_job_clarity", "route_fidelity", "cross_slide_coherence", "passed"],
      "properties": {
        "storyline_coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "slide_job_clarity": {"type": "number", "minimum": 0, "maximum": 1},
        "route_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_slide_coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
