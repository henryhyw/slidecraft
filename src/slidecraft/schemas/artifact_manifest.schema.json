{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/artifact_manifest.schema.json",
  "title": "Slidecraft Artifact Manifest",
  "type": "object",
  "required": ["schema_version", "workspace_id", "control_model", "artifacts", "active", "events"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": ["string", "null"]},
    "control_model": {"const": "agent_host"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "logical_key", "kind", "revision", "path", "sha256", "producer", "dependencies", "lifecycle"],
        "properties": {
          "artifact_id": {"type": "string"},
          "logical_key": {"type": "string"},
          "kind": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "producer": {"type": "string"},
          "dependencies": {"type": "array"},
          "lifecycle": {"enum": ["candidate", "active", "superseded", "rejected"]}
        }
      }
    },
    "active": {"type": "object", "additionalProperties": {"type": "string"}},
    "events": {"type": "array"}
  }
}
