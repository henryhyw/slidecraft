{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/clarification_package.schema.json",
  "title": "Slidecraft Clarification Package",
  "type": "object",
  "required": ["schema_version", "phase", "questions", "interaction", "can_proceed_without_answers"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "phase": {"const": "before_deck_planning"},
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question_id", "impact_dimension", "prompt", "why_it_matters", "planning_decisions_affected", "source_basis", "response_type", "options", "authored_by"],
        "properties": {
          "question_id": {"type": "string"},
          "impact_dimension": {"type": "string"},
          "prompt": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "planning_decisions_affected": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "response_type": {"type": "string"},
          "options": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
          "authored_by": {"const": "agent_reasoning"}
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["all_questions_optional", "allow_skip_all", "preferred_host_surface", "fallback_surface"]
    },
    "reasoning_ownership": {"type": "object"},
    "can_proceed_without_answers": {"const": true}
  }
}
