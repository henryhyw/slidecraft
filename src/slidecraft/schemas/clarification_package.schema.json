{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/clarification_package.schema.json",
  "title": "Slidecraft Clarification Package",
  "type": "object",
  "required": ["schema_version", "phase", "questions", "interaction", "can_proceed_without_answers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": "before_deck_planning"},
    "questions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["question_id", "impact_dimension", "prompt", "why_it_matters", "options", "value_score"],
        "properties": {
          "question_id": {"type": "string"},
          "impact_dimension": {"type": "string"},
          "prompt": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "value_score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["all_questions_optional", "allow_skip_all", "preferred_host_surface", "fallback_surface"]
    },
    "can_proceed_without_answers": {"const": true}
  }
}
