{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "authored_by", "visual_references", "icons", "components"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authored_by": {"const": "agent_reasoning"},
    "decision_context": {"type": "object"},
    "visual_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "rationale"],
        "properties": {
          "reference_id": {"type": "string"},
          "rationale": {"type": "string", "minLength": 8}
        },
        "additionalProperties": true
      }
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semantic_role", "asset_id", "rationale"],
        "properties": {
          "semantic_role": {"type": "string"},
          "asset_id": {"type": "string"},
          "rationale": {"type": "string", "minLength": 8},
          "selection_mode": {"type": "string"},
          "allow_reuse": {"type": "boolean"},
          "prompt_name": {"type": "string"},
          "prompt_description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "rationale"],
        "properties": {
          "component_id": {"type": "string"},
          "rationale": {"type": "string", "minLength": 8}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
