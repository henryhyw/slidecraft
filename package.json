{
  "name": "slidepoise",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Node dependencies for the SlidePoise presentation framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryhyw/slidecraft.git"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "keywords": [
    "powerpoint",
    "presentations",
    "agent",
    "pptxgenjs"
  ],
  "bin": {
    "slidepoise": "bin/slidepoise.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "bin/",
    "framework/",
    "profiles/",
    "library-sets/",
    "slidepoise/",
    "webapp/",
    "pyproject.toml",
    "setup.py",
    "MANIFEST.in",
    "README.md",
    "SECURITY.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.DS_Store"
  ],
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  }
}
