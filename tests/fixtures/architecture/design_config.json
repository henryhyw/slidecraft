{
  "schema_version": "1.0.0",
  "preflight_config": "preflight_config.json",
  "deck_planning_config": "deck_planning_config.json",
  "density_profile": "high_consulting",
  "guidance_profile": {
    "profile_id": "consulting",
    "path": "../src/slidecraft/guidance_profiles/consulting.json",
    "inheritance_root": "../src/slidecraft/guidance_profiles"
  },
  "local_libraries": {
    "visual_reference_manifest": "../inputs/visual_references/library_manifest.json",
    "icon_root": "../assets/tabler",
    "known_component_root": "../examples/local_library/components",
    "visual_reference_max_results_per_slide": 3,
    "retrieval_mode": "semantic_metadata_first"
  },
  "config_id": "consulting_orange_16x9_test",
  "provenance": "Synthetic predefined deck design configuration for the orchestration prototype",
  "full_slide_px": [2048, 1152],
  "exclusions_px": {
    "header": 41,
    "footer": 41
  },
  "exclusion_resolution": {
    "mode": "configured",
    "configured_values_are_authoritative": true,
    "adaptive_derivation_supported_through_adapter": true,
    "adapter_interface": "header_footer_exclusion_resolver_v1",
    "future_modes": ["configured", "adaptive", "configured_with_adaptive_fallback"]
  },
  "deck_chrome": {
    "enabled": true,
    "generation_excluded": true,
    "application_stage": "post_reconstruction",
    "geometry_source": "configured_header_footer_exclusions",
    "variant_selection": {
      "mode": "configured_with_reasoning_adapter",
      "default_variant": "content_slide",
      "allowed_variants": ["content_slide", "section_divider", "title_slide", "appendix"],
      "adapter_interface": "deck_chrome_variant_selector_v1",
      "reasoning_inputs": ["slide_role", "section", "audience", "confidentiality", "explicit_human_constraints"],
      "geometry_and_style_remain_deterministic_after_selection": true
    },
    "current_slide_variant": "content_slide",
    "content_resolution": {
      "priority": ["user_provided", "framework_proposed", "derived_fallback"],
      "proposal_inputs": ["project_name", "slide_title", "slide_role", "section", "organization", "confidentiality", "date", "slide_number"],
      "resolve_per_slide": true,
      "require_preflight_confirmation": true
    },
    "outer_padding_px": 40,
    "font_family": "Arial",
    "header": {
      "font_size_px": 13,
      "font_weight": "bold",
      "text_color": "#4A4A4A",
      "secondary_text_color": "#968C6D",
      "rule_color": "#DED7CF",
      "rule_width_px": 1,
      "accent_color": "#D93900",
      "accent_rule_width_px": 120
    },
    "footer": {
      "font_size_px": 12,
      "font_weight": "regular",
      "left_font_weight": "bold",
      "text_color": "#4A4A4A",
      "secondary_text_color": "#968C6D",
      "rule_color": "#DED7CF",
      "rule_width_px": 1
    }
  },
  "title": {
    "anchor_px": [64, 48],
    "max_width_px": 1860,
    "font_family": "Georgia",
    "weight": "regular",
    "nominal_size_px": 76,
    "color": "#111111",
    "alignment": "left",
    "allowed_lines": [1, 2],
    "minimum_gap_to_body_px": 36
  },
  "style": {
    "background": "clean white",
    "display_font": "Georgia",
    "body_font": "Arial",
    "accent_colors": ["#D93900", "#EB8C00", "#E0301E"],
    "neutral_colors": ["#111111", "#4A4A4A", "#E1E1E1", "#F2F2F2", "#FFFFFF"],
    "density": "moderately dense consulting-slide",
    "whitespace": "generous outside the information architecture and consistent within repeated components",
    "visual_conventions": "strong hierarchy, clean alignment, restrained fills, thin rules, explicit process relationships",
    "diagram_conventions": "clear directional flow, compact internal branches, purposeful connectors, no decorative legend",
    "icon_treatment": "simple Tabler-style outline pictograms in signature orange, proportionally contain-fitted and centered above a pale PwC warm-tint rectangular slot surface with consistent padding. Identity logos retain their canonical colors and are exempt from pictogram recoloring.",
    "brand_inspiration": {
      "name": "PwC-inspired consulting aesthetic",
      "status": "synthetic configurable approximation, not an official PwC brand standard",
      "personality": ["bold", "collaborative", "optimistic", "fast", "sharp", "focused"],
      "color_roles": {
        "signature_orange": "#D93900",
        "bright_orange": "#EB8C00",
        "red": "#E0301E",
        "burgundy": "#602320",
        "warm_yellow": "#FFB600",
        "warm_tints": ["#FCE4D6", "#F7D7C4", "#FFF0D6"],
        "warm_neutrals": ["#F2F2F2", "#DED7CF", "#968C6D"]
      },
      "color_usage": "Lead with white space and near-black typography. Use signature orange for hierarchy and directional emphasis. Use red, burgundy, yellow, warm tints, and warm neutrals selectively to distinguish information families without creating a rainbow palette.",
      "shape_language": "Use crisp rectangular color blocks, restrained cropped wedges or slanted momentum accents, thin warm-gray rules, and occasional stepped block relationships. Keep shape use purposeful and flat.",
      "surface_language": "Use white as the primary field, pale warm tint panels for secondary grouping, and saturated color blocks for small high-emphasis regions. Avoid decorative gradients and excessive rounded cards.",
      "research_basis": [
        "https://www.pwc.com/gx/en/news-room/time-for-change.html",
        "https://www.pwc.com/us/en/about-us/newsroom/press-releases/brand-evolution-at-the-forefront-of-change.html",
        "https://www.pwc.com/gx/en/about/ethics/pwc-code-of-conduct.pdf"
      ]
    }
  },
  "icon_slots": {
    "enabled": true,
    "authoritative_placement_object": "slot_box",
    "generated_glyph_is_authoritative": false,
    "default_inset_fraction": 0.14,
    "minimum_inset_px": 8,
    "alignment": "center",
    "fit": "contain",
    "allow_stretch": false,
    "compute_contain_geometry_explicitly": true,
    "maximum_aspect_ratio_error": 0.001,
    "maximize_icon_within_inset_area": true,
    "generation_tolerance_percent": 4,
    "minimum_external_clearance_px": 12,
    "generation_rendering": "Use a clear rectangular design container with a very light neutral or warm-tint surface. Keep its edges readable enough to establish the allocated region without drawing measurement guides or dashed annotations.",
    "reconstruction_rendering": "Remove the temporary slot surface when it is only placement scaffolding. Retain it when it is visibly part of the intended component design.",
    "standard_pictogram_surface": {
      "enabled": true,
      "fill": "#FCE4D6",
      "alternate_fills": ["#F7D7C4", "#FFF0D6"],
      "border": "none",
      "glyph_color": "#D93900",
      "glyph_z_order": "above_slot_surface",
      "applies_to": "library pictograms and icons",
      "exemptions": ["user-provided logos", "protected identity assets"]
    }
  },
  "user_asset_policy": {
    "generation_attachment_mode": "description_only",
    "default_requirement": "optional",
    "mandatory_asset_ids": ["USER_LOGO_OPENAI", "USER_LOGO_OPENCV", "USER_LOGO_POWERPOINT"],
    "downstream_restore_exact_canonical_asset": true
  },
  "text_reconstruction": {
    "font_size_quantization_pt": 0.5,
    "font_size_quantization_direction": "down",
    "absolute_minimum_font_size_pt": 5.0,
    "final_overflow_validation_required": true,
    "revalidate_supplied_fitted_contracts": true,
    "include_bullet_prefix_in_fit_measurement": true,
    "explicit_no_autofit_in_ooxml": true
  },
  "normalization": {
    "decision_owner": "host_agent",
    "constraints": {
      "minimum_alignment_confidence": 0.82,
      "alignment_tolerance_px": 2.0,
      "maximum_translation_px": 16.0,
      "maximum_translation_object_fraction": 0.2,
      "minimum_useful_translation_px": 3.0,
      "parent_inner_padding_px": 6.0,
      "minimum_clearance_px": 4.0,
      "minimum_error_improvement_ratio": 0.35,
      "preserve_object_dimensions_by_default": true,
      "move_semantic_groups_rigidly": true,
      "reroute_attached_native_connectors_after_move": true,
      "rollback_on_new_collision": true,
      "rollback_on_parent_overflow": true,
      "rollback_on_text_overflow": true
    }
  },
  "connectors": {
    "style_id": "consulting_flow_v1",
    "allowed_routing_types": ["straight", "elbow", "curved", "straight_shared_junction", "elbow_shared_junction", "curved_shared_junction"],
    "default_route": "straight",
    "branch_route": "elbow_shared_junction",
    "topology_routes": {
      "merge_shared_junction": "elbow_shared_junction",
      "branch_shared_junction": "elbow_shared_junction",
      "many_to_many_shared_junction": "elbow_shared_junction"
    },
    "stroke": {
      "color": "#D93900",
      "width_px": 4,
      "dash": "solid",
      "line_cap": "round",
      "line_join": "round"
    },
    "arrowhead": {
      "type": "triangle",
      "length_px": 20,
      "width_px": 18,
      "powerpoint_size": "lg",
      "minimum_visible_endpoint_px": 18,
      "minimum_clear_segment_px": 34
    },
    "junction": {
      "style": "none",
      "diameter_px": 10,
      "visible_only_when_semantic_node": true
    },
    "routing": {
      "minimum_clearance_px": 12,
      "minimum_bend_spacing_px": 20,
      "maximum_ordinary_bends": 2,
      "avoid_crossing_text": true,
      "avoid_crossing_peer_components": true,
      "normalize_peer_routes": true,
      "prefer_axis_aligned_segments": true,
      "terminal_approach_must_be_straight": true,
      "avoid_redundant_terminal_bends": true,
      "collapse_aligned_one_to_one": true,
      "snap_near_axis_segments": true,
      "segment_join_policy": "exact_shared_endpoint",
      "segment_line_cap": "round",
      "use_measured_terminal_anchor_over_container_center": true,
      "axis_alignment_tolerance_px": 8
    },
    "qa": {
      "check_arrowhead_legibility": true,
      "check_arrowhead_to_stroke_ratio": true,
      "arrowhead_length_to_stroke_ratio": [3.0, 5.0],
      "check_endpoint_attachment": true,
      "check_label_and_component_collisions": true,
      "check_branch_junction_clarity": true,
      "simplify_unnecessary_bends": true,
      "native_connector_objects_only": true,
      "forbid_separate_arrowhead_shapes": true,
      "forbid_connector_fragment_tracing": true,
      "consolidate_redundant_raster_paths": true,
      "preserve_semantic_merge_topology": true,
      "normalize_horizontal_peer_flows": true,
      "allow_non_rendering_routing_ports": true
    }
  },
  "icon_library": {
    "provider": "tabler",
    "variant": "outline",
    "version": "v3.46.0",
    "root": "assets/tabler",
    "stroke_width": 2
  },
  "icon_library_root": "assets/tabler",
  "generation_review_config": "generation_review_config.json"
}
