{
  "schema_version": "1.0.0",
  "interaction": {
    "prompt_during_pipeline_run": false,
    "missing_optional_capability": "skip_with_report",
    "missing_required_capability": "fail_once_with_action"
  },
  "permissions": {
    "policy": "explicit_setup_only",
    "powerpoint_automation": {
      "enabled_by_default": false,
      "authorization_command": "slidecraft authorize-powerpoint",
      "validation_command": "slidecraft render-powerpoint",
      "timeout_seconds": 120
    }
  },
  "constructor": {
    "backend": "auto",
    "preferred_backend": "pptxgenjs",
    "backend_selection": "certified_portable_backend",
    "node_modules_env": "SLIDECRAFT_NODE_MODULES",
    "missing_backend": "fail_once_with_action"
  },
  "segmentation": {
    "mode": "eligible_entities_only",
    "checkpoint_download": "setup_only"
  },
  "providers": {
    "credential_prompt_during_run": false,
    "missing_optional_provider": "skip_with_report"
  }
}
