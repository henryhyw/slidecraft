{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/generation-preflight-1.0.0.json",
  "title": "Generation Preflight",
  "type": "object",
  "required": ["schema_version", "run_id", "approval", "system_configuration", "slides", "assets", "quality"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "approval": {
      "type": "object",
      "required": ["required", "mode", "status", "fingerprint"],
      "properties": {
        "required": {"type": "boolean"},
        "mode": {"enum": ["interactive_required", "explicit_delegation", "policy_auto_approval"]},
        "status": {"enum": ["awaiting_user_confirmation", "approved", "changes_requested", "blocked"]},
        "fingerprint": {"type": "string"}
      }
    },
    "system_configuration": {"type": "object"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "objective", "title", "route", "chrome", "source_coverage", "constraints"],
        "properties": {
          "slide_id": {"type": "string"},
          "objective": {"type": "string"},
          "governing_message": {"type": "string"},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "route": {"enum": ["image_generation", "system_layout"]},
          "chrome": {"type": "object"},
          "source_coverage": {"type": "object"},
          "constraints": {"type": "array"},
          "unresolved_assumptions": {"type": "array"}
        }
      }
    },
    "assets": {"type": "array"},
    "visual_references": {"type": "array"},
    "quality": {
      "type": "object",
      "required": ["ready_for_approval", "blocking_issues"],
      "properties": {
        "ready_for_approval": {"type": "boolean"},
        "blocking_issues": {"type": "array"},
        "warnings": {"type": "array"}
      }
    },
    "detail_files": {"type": "object"}
  }
}
