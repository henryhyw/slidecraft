{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/known-component-1.0.0.json",
  "title": "Slidecraft Known Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "version",
    "name",
    "semantic",
    "recognition",
    "implementation",
    "parameters",
    "bindings",
    "policies",
    "preview"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "concepts"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "aliases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_parts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "relationship_types": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_confidence"],
      "properties": {
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visual_signatures": {
          "type": "array",
          "items": {"type": "string"}
        },
        "aspect_ratio_range": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["pptx_fragment", "primitive_recipe", "python_factory"]
        },
        "source": {
          "type": "string"
        },
        "slide_index": {
          "type": "integer",
          "minimum": 0
        },
        "root_shape_name": {
          "type": "string"
        },
        "factory_entrypoint": {
          "type": "string"
        },
        "editable_object_types": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "python_factory"}}},
          "then": {"required": ["factory_entrypoint"]},
          "else": {"required": ["source"]}
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["string", "number", "integer", "boolean", "color", "string_array", "data_table"]
          },
          "required": {"type": "boolean"},
          "default": {},
          "description": {"type": "string"}
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "selector", "property"],
        "properties": {
          "parameter": {"type": "string"},
          "selector": {"type": "string"},
          "property": {"type": "string"},
          "transform": {"type": "string"}
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "x", "y", "direction"],
        "properties": {
          "name": {"type": "string"},
          "x": {"type": "number", "minimum": 0, "maximum": 1},
          "y": {"type": "number", "minimum": 0, "maximum": 1},
          "direction": {"enum": ["left", "right", "top", "bottom", "any"]},
          "relationship_types": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resize", "recolor", "typography"],
      "properties": {
        "resize": {
          "enum": ["contain", "cover", "stretch", "fixed_aspect"]
        },
        "recolor": {
          "enum": ["none", "role_based", "parameter_only"]
        },
        "typography": {
          "enum": ["preserve", "inherit_deck", "parameter_only"]
        },
        "allow_part_removal": {"type": "boolean"},
        "allow_part_duplication": {"type": "boolean"}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {"type": "string"},
        "example_parameters": {"type": "string"}
      }
    }
  }
}
