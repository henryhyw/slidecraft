{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/guidance-profile-1.0.0.json",
  "title": "Slidecraft Guidance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "version",
    "description",
    "deck_reasoning",
    "slide_reasoning",
    "semantic_output_guidance",
    "visual_communication",
    "writing",
    "review",
    "anti_patterns",
    "design_freedom"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "extends": {"type": ["string", "null"]},
    "applicability": {
      "type": "object",
      "additionalProperties": true
    },
    "deck_reasoning": {
      "type": "object",
      "required": ["principles", "diagnostics"],
      "properties": {
        "principles": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "storyline_archetypes": {"type": "object"},
        "recommended_outputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "slide_reasoning": {
      "type": "object",
      "required": ["principles", "diagnostics"],
      "properties": {
        "principles": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "recommended_outputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "semantic_output_guidance": {
      "type": "object",
      "properties": {
        "deck_fields": {"type": "array", "items": {"type": "string"}},
        "slide_fields": {"type": "array", "items": {"type": "string"}},
        "optional_fields_are_contextual": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "visual_communication": {
      "type": "object",
      "required": ["principles", "diagnostics"],
      "properties": {
        "principles": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "writing": {
      "type": "object",
      "required": ["principles"],
      "properties": {
        "principles": {"type": "array", "items": {"type": "string"}},
        "title_policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "questions": {"type": "array", "items": {"type": "string"}},
        "deck_diagnostics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "anti_patterns": {"type": "array", "items": {"type": "string"}},
    "design_freedom": {"type": "array", "items": {"type": "string"}},
    "exclusions": {
      "type": "array",
      "description": "Concerns explicitly owned by configuration, libraries, or reconstruction instead of the guidance profile.",
      "items": {"type": "string"}
    }
  }
}
