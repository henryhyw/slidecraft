{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/intake-manifest-1.0.0.json",
  "title": "Slidecraft Multimodal Intake Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slide_id",
    "objective",
    "source_atoms",
    "constraint_register",
    "materials",
    "conflict_register",
    "unresolved_constraint_ids",
    "hard_constraint_ids",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "slide_id": {"type": "string"},
    "objective": {"type": "string"},
    "source_atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom_id", "source_path", "modality", "value", "authority", "required_usage", "citation"],
        "properties": {
          "atom_id": {"type": "string"},
          "source_path": {"type": "string"},
          "modality": {"type": "string"},
          "value": {},
          "authority": {"enum": ["authoritative", "intent_evidence", "supporting_evidence", "derived"]},
          "required_usage": {"type": "boolean"},
          "citation": {
            "type": "object",
            "required": ["material_id", "locator"],
            "properties": {
              "material_id": {"type": "string"},
              "locator": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "constraint_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "text", "strength", "category", "target", "source", "confidence", "status"],
        "properties": {
          "constraint_id": {"type": "string"},
          "text": {"type": "string"},
          "strength": {"enum": ["hard", "soft", "preference"]},
          "category": {"type": "string"},
          "target": {"type": "string"},
          "source": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["active", "superseded", "conflicted", "needs_resolution"]}
        },
        "additionalProperties": true
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["material_id", "modality", "role", "authority", "required_usage", "agent_content_present", "provenance"],
        "properties": {
          "material_id": {"type": "string"},
          "modality": {"enum": ["text", "structured_text", "document", "presentation", "pdf", "spreadsheet", "image", "diagram", "canonical_asset", "audio", "url"]},
          "role": {"type": "string"},
          "description": {"type": "string"},
          "authority": {"type": "string"},
          "required_usage": {"type": "boolean"},
          "path": {"type": ["string", "null"]},
          "agent_content_present": {"type": "boolean"},
          "content": {},
          "provenance": {"type": "string"},
          "sha256": {"type": ["string", "null"]},
          "size_bytes": {"type": ["integer", "null"]}
        },
        "additionalProperties": true
      }
    },
    "conflict_register": {"type": "array", "items": {"type": "object"}},
    "unresolved_constraint_ids": {"type": "array", "items": {"type": "string"}},
    "hard_constraint_ids": {"type": "array", "items": {"type": "string"}},
    "quality": {
      "type": "object",
      "required": ["authoritative_source_atom_count", "material_count", "hard_constraint_count", "requires_user_resolution"],
      "properties": {
        "authoritative_source_atom_count": {"type": "integer", "minimum": 0},
        "material_count": {"type": "integer", "minimum": 0},
        "hard_constraint_count": {"type": "integer", "minimum": 0},
        "requires_user_resolution": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
