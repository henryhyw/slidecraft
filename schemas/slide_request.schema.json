{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/slide-request-1.0.0.json",
  "title": "Slidecraft Slide Request",
  "type": "object",
  "required": ["schema_version", "slide_id", "objective", "exact_content"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "slide_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "exact_content": {
      "type": "object",
      "description": "Authoritative slide content and data. The internal structure may vary by slide type."
    },
    "user_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "explicit_human_constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "constraint_id": {"type": "string"},
              "text": {"type": "string"},
              "strength": {"enum": ["hard", "soft", "preference"]},
              "category": {"type": "string"},
              "target": {"type": "string"},
              "source": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "status": {"enum": ["active", "superseded", "conflicted", "needs_resolution"]}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["material_id", "modality"],
        "properties": {
          "material_id": {"type": "string"},
          "modality": {"enum": ["text", "structured_text", "document", "pdf", "spreadsheet", "image", "diagram", "audio", "url"]},
          "path": {"type": "string"},
          "content": {},
          "role": {"type": "string"},
          "description": {"type": "string"},
          "authority": {"enum": ["authoritative", "supporting", "intent_evidence"]},
          "required_usage": {"type": "boolean"},
          "provenance": {"type": "string"}
        },
        "anyOf": [
          {"required": ["path"]},
          {"required": ["content"]}
        ],
        "additionalProperties": true
      }
    },
    "user_provided_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "semantic_role", "name", "description", "canonical_file"],
        "properties": {
          "asset_id": {"type": "string"},
          "semantic_role": {"type": "string"},
          "dimension_role": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "canonical_file": {"type": "string"},
          "required_usage": {"type": "boolean"},
          "mandatory": {"type": "boolean"},
          "allowed_transformations": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "approval_mode": {
      "enum": ["interactive_required", "explicit_delegation", "policy_auto_approval"],
      "default": "interactive_required"
    },
    "ingested_asset_manifest": {
      "type": "string",
      "description": "Optional project-scoped manifest produced by the chat-attachment asset ingestor."
    },
    "generation_route": {
      "enum": ["image_generation", "system_layout"],
      "default": "image_generation"
    },
    "chrome_content": {
      "type": "object",
      "description": "Run-resolved header and footer content. Geometry and styling remain in deck design configuration.",
      "properties": {
        "variant": {"type": "string"},
        "header": {
          "type": "object",
          "properties": {
            "left_text": {"type": "string"},
            "right_text": {"type": "string"}
          }
        },
        "footer": {
          "type": "object",
          "properties": {
            "left_text": {"type": "string"},
            "center_text": {"type": "string"},
            "right_text_format": {"type": "string"}
          }
        }
      }
    },
    "chrome_content_proposal": {
      "type": "object",
      "description": "Framework-proposed run-specific chrome content shown to the user during preflight.",
      "properties": {
        "variant": {"type": "string"},
        "header": {"type": "object"},
        "footer": {"type": "object"}
      }
    },
    "run_context": {
      "type": "object",
      "description": "Run-specific project, organization, confidentiality, date, and slide metadata used for proposals."
    },
    "semantic_design_path": {"type": "string"},
    "semantic_design": {"type": "object"},
    "fixed_visual_references": {
      "type": "array",
      "description": "Legacy test input. Metadata library retrieval supersedes this field.",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": true
}
