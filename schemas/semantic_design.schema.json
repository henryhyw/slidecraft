{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/semantic-design-1.0.0.json",
  "title": "Slidecraft Semantic Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planner",
    "guidance_profile_id",
    "main_message",
    "communication_archetype",
    "semantic_units",
    "semantic_relationships",
    "hierarchy",
    "reading_logic",
    "supporting_information",
    "visual_intent",
    "candidate_structures",
    "selected_structure_id",
    "source_traceability",
    "asset_needs",
    "quality_evaluation",
    "exact_content_is_authoritative"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "planner": {
      "type": "object",
      "required": ["provider_mode", "method"],
      "properties": {
        "provider_mode": {"enum": ["managed_brain", "host_brain", "recorded_fixture"]},
        "method": {"type": "string"},
        "provider": {"type": "string"},
        "model": {"type": "string"}
      },
      "additionalProperties": true
    },
    "guidance_profile_id": {"type": "string"},
    "audience_question": {"type": "string"},
    "dominant_claim": {"type": "string"},
    "role_in_deck_argument": {"type": "string"},
    "argument_structure": {"type": "array", "items": {"type": "object"}},
    "evidence_bindings": {"type": "array", "items": {"type": "object"}},
    "visual_obligations": {"type": "array", "items": {"type": "string"}},
    "main_message": {"type": "string", "minLength": 1},
    "communication_archetype": {"type": "string", "minLength": 1},
    "semantic_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "source_paths", "importance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"type": "string"},
          "meaning": {"type": "string"},
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "importance": {"enum": ["primary", "secondary", "supporting"]},
          "children": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "semantic_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "members"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "members": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "meaning": {"type": "string"},
          "directionality": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "hierarchy": {
      "type": "object",
      "required": ["primary", "secondary", "supporting"],
      "properties": {
        "primary": {"type": "array", "items": {"type": "string"}},
        "secondary": {"type": "array", "items": {"type": "string"}},
        "supporting": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "reading_logic": {"type": "string"},
    "supporting_information": {"type": "string"},
    "visual_intent": {
      "type": "object",
      "required": ["structure", "relationships", "emphasis", "composition_freedom", "layout_agnostic"],
      "properties": {
        "structure": {"type": "string"},
        "relationships": {"type": "string"},
        "emphasis": {"type": "string"},
        "composition_freedom": {"type": "string"},
        "layout_agnostic": {"const": true},
        "avoid": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "candidate_structures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "archetype", "description", "scores", "total_score", "tradeoffs"],
        "properties": {
          "id": {"type": "string"},
          "archetype": {"type": "string"},
          "description": {"type": "string"},
          "scores": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 5}
          },
          "total_score": {"type": "number"},
          "tradeoffs": {"type": "string"}
        }
      }
    },
    "selected_structure_id": {"type": "string"},
    "source_traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "semantic_unit_ids", "status"],
        "properties": {
          "source_path": {"type": "string"},
          "semantic_unit_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["mapped", "supporting", "excluded_by_explicit_policy"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "asset_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semantic_role", "purpose", "requirement"],
        "properties": {
          "semantic_role": {"type": "string"},
          "purpose": {"type": "string"},
          "requirement": {"enum": ["mandatory", "optional"]}
        },
        "additionalProperties": true
      }
    },
    "quality_evaluation": {
      "type": "object",
      "required": ["objective_alignment", "content_coverage", "relationship_clarity", "hierarchy_clarity", "density_feasibility", "passed"],
      "properties": {
        "objective_alignment": {"type": "number", "minimum": 0, "maximum": 1},
        "content_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "relationship_clarity": {"type": "number", "minimum": 0, "maximum": 1},
        "hierarchy_clarity": {"type": "number", "minimum": 0, "maximum": 1},
        "density_feasibility": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"},
        "risks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "exact_content_is_authoritative": {"const": true}
  }
}
