{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidecraft.dev/schemas/deck-plan-1.0.0.json",
  "title": "Slidecraft Deck Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "governing_thought",
    "storyline_archetype",
    "density_profile",
    "density_analysis",
    "sections",
    "slides",
    "source_allocation",
    "design_system_snapshot",
    "quality_evaluation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deck_id": {"type": "string"},
    "governing_thought": {"type": "string"},
    "storyline_archetype": {"type": "string"},
    "density_profile": {
      "type": "object",
      "required": ["profile_id", "description", "sparse_content_slides_allowed"],
      "properties": {
        "profile_id": {"type": "string"},
        "description": {"type": "string"},
        "target_semantic_units_per_content_slide": {"type": "array"},
        "target_supporting_evidence_items": {"type": "array"},
        "target_relationships": {"type": "array"},
        "target_body_word_range": {"type": "array"},
        "sparse_content_slides_allowed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "density_analysis": {
      "type": "object",
      "required": ["evidence_unit_count", "derived_content_slide_range", "planned_content_slide_count"],
      "properties": {
        "evidence_unit_count": {"type": "integer", "minimum": 0},
        "derived_content_slide_range": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
          "items": false
        },
        "planned_content_slide_count": {"type": "integer", "minimum": 1},
        "structural_slide_count": {"type": "integer", "minimum": 0},
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "number", "title", "purpose", "slide_ids"],
        "properties": {
          "section_id": {"type": "string"},
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "purpose": {"type": "string"},
          "promise": {"type": "string"},
          "accent_role": {"type": "string"},
          "divider_required": {"type": "boolean"},
          "slide_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "ordinal", "section_id", "role", "communication_job", "message_title", "source_atom_ids", "relationships", "route", "route_reason"],
        "properties": {
          "slide_id": {"type": "string"},
          "ordinal": {"type": "integer", "minimum": 1},
          "section_id": {"type": "string"},
          "role": {"type": "string"},
          "communication_job": {"type": "string"},
          "message_title": {"type": "string"},
          "source_atom_ids": {"type": "array", "items": {"type": "string"}},
          "relationships": {"type": "array"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "complexity": {"type": "number", "minimum": 0, "maximum": 1},
          "visual_novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "semantic_unit_count": {"type": "integer", "minimum": 0},
          "supporting_evidence_count": {"type": "integer", "minimum": 0},
          "authoritative_data_form": {"enum": ["none", "table", "chart", "mixed"]},
          "known_component_match": {
            "type": "object",
            "properties": {
              "component_id": {"type": ["string", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": true
          },
          "route": {"enum": ["system_layout", "image_generation"]},
          "route_reason": {"type": "string"},
          "system_layout_id": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "source_allocation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_atom_id", "slide_ids", "status"],
        "properties": {
          "source_atom_id": {"type": "string"},
          "slide_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["used", "appendix", "excluded_with_reason"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "design_system_snapshot": {"type": "object"},
    "quality_evaluation": {
      "type": "object",
      "required": ["storyline_coherence", "source_coverage", "slide_job_clarity", "route_fidelity", "cross_slide_coherence", "passed"],
      "properties": {
        "storyline_coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "slide_job_clarity": {"type": "number", "minimum": 0, "maximum": 1},
        "route_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_slide_coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"},
        "risks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
